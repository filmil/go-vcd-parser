# The build's one dependency manifest. Everything the WORKSPACE used to fetch
# lives here as bzlmod modules; go.mod is the source of truth for the Go
# dependency graph and the Go version.
module(name = "go-vcd-parser")

# `repo_name` keeps the label every BUILD file already uses.
bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.53.0", repo_name = "bazel_gazelle")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_alecthomas_participle_v2",
    "com_github_davecgh_go_spew",
    "com_github_dsnet_golib_unitconv",
    "com_github_golang_glog",
    "com_github_mattn_go_sqlite3",
    "org_golang_x_text",
)

# --- Hermetic C/C++ toolchain ------------------------------------------------
#
# Both binaries link mattn/go-sqlite3, so every build is a CGO build. The zig
# toolchain cross-compiles that C for every release platform from one Linux
# machine, with no compiler taken from the host.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

# zig's macOS headers omit resolv.h, and Go's cgo stdlib includes it, so a
# darwin cross-build of any CGO program dies inside the Go standard library.
# The patches write stub headers and link stubs into the zig SDK and teach
# the wrapper to use them; each patch states its exact contract. Drop them
# when zig ships the pieces.
single_version_override(
    module_name = "hermetic_cc_toolchain",
    patch_strip = 1,
    patches = [
        "//patches:hermetic_cc_toolchain-darwin-resolv.patch",
        "//patches:hermetic_cc_toolchain-darwin-lresolv-wrapper.patch",
    ],
    version = "4.3.0",
)

toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(toolchains, "zig_sdk")

# glibc 2.31 for the Linux targets: old enough to run on anything Debian 11
# or newer, and pinned so the binary does not inherit the build machine's.
register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.31",
    "@zig_sdk//toolchain:darwin_amd64",
    "@zig_sdk//toolchain:darwin_arm64",
)
