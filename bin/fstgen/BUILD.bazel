load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "fstgen_lib",
    srcs = ["main.go"],
    importpath = "github.com/filmil/go-vcd-parser/bin/fstgen",
    visibility = ["//visibility:private"],
